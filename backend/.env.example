PORT=4000

# Cadena de conexion directa a Postgres (Supabase: Project Settings > Database > Connection string)
DATABASE_URL=postgresql://postgres:PASSWORD@db.xxxxx.supabase.co:5432/postgres

# Secreto para firmar los JWT propios (no es el de Supabase)
JWT_SECRET=cambiar-por-un-secreto-largo-y-aleatorio
JWT_EXPIRES_IN=7d

# Origen permitido para CORS (URL del frontend Vite)
CORS_ORIGIN=http://localhost:5173

# Datos para "npm run seed:admin" (crea/promueve un usuario admin inicial)
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@perfumeria.com
ADMIN_PASSWORD=cambiar-esta-clave

